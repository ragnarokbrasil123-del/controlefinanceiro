# Copie para .env.local e preencha com os valores do seu projeto.

# --- OBRIGATORIO: sem isto o app nao sobe ---
# Painel do Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# --- OPCIONAL: recursos de IA ---
# Deixe ausente (ou diferente de "true") para o app subir sem IA:
# os botoes de Ler Foto, Conselheiro e Auto-Orcamento ficam ocultos.
# Para ligar, defina AS DUAS variaveis abaixo.
NEXT_PUBLIC_AI_ENABLED=false
GEMINI_API_KEY=
